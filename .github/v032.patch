+++ gmo-v032/styles/media-overlay.css	2026-10-16 09:11:04.331127030 +0000
@@ -458,6 +458,20 @@
   box-sizing: border-box;
 }
 
+/* Les cadres simples sont rendus comme une surcouche complète. Cela conserve
+   leur dessin au lieu de les découper arbitrairement en 9-slice. */
+.gmo-frame-custom-overlay::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 4;
+  background-image: var(--gmo-custom-frame-image);
+  background-position: center;
+  background-size: 100% 100%;
+  background-repeat: no-repeat;
+  pointer-events: none;
+}
+
 /* Contrôles runtime : restent toujours opaques, même si le contenu ne l'est pas. */
 .gmo-floating-chrome {
   position: absolute;
