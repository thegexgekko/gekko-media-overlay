<section class="gmo-manager-body">
  <header class="gmo-manager-toolbar">
    <div>
      <h2>Fenêtres média</h2>
      <p>Chaque fenêtre possède son contenu, son style, sa taille, sa position et ses destinataires.</p>
    </div>
    <div class="gmo-toolbar-actions">
      <button type="button" data-action="reloadFrames" title="Recharge les cadres personnalisés depuis Data/{{customFrameRoot}}">
        <i class="fa-solid fa-rotate"></i> Cadres perso
      </button>
      <button type="button" data-action="new">
        <i class="fa-solid fa-plus"></i> Nouvelle fenêtre
      </button>
      <button type="button" data-action="closeAll" class="gmo-danger-soft">
        <i class="fa-solid fa-xmark"></i> Tout fermer
      </button>
    </div>
  </header>

  {{#unless hasOverlays}}
    <div class="gmo-empty-state">
      <i class="fa-solid fa-photo-film"></i>
      <strong>Aucune fenêtre configurée.</strong>
      <span>Crée ta première fenêtre avec le bouton ci-dessus.</span>
    </div>
  {{/unless}}

  <div class="gmo-overlay-list">
    {{#each overlays}}
      <article class="gmo-overlay-card {{#if isSelectedMode}}gmo-target-selected{{/if}} {{#if isFixedMode}}gmo-placement-fixed{{else}}gmo-placement-floating{{/if}} {{#if isGMFloatingMode}}gmo-placement-gm{{/if}} {{#if isPlayerFloatingMode}}gmo-placement-player{{/if}} {{#if isMediaContent}}gmo-content-media{{/if}} {{#if isTextContent}}gmo-content-text{{/if}} {{#if isHtmlContent}}gmo-content-html{{/if}} {{#if isCustomFrame}}gmo-frame-custom-selected{{/if}}" data-overlay-id="{{id}}">
        <div class="gmo-card-header">
          <input class="gmo-name" name="name" type="text" value="{{name}}" aria-label="Nom de la fenêtre">
          <span class="gmo-status {{#if active}}is-active{{/if}}">
            <i class="fa-solid {{#if active}}fa-circle-play{{else}}fa-circle-stop{{/if}}"></i>
            {{statusLabel}}
          </span>
        </div>

        <div class="gmo-grid">
          <div class="gmo-field">
            <label>Type de contenu</label>
            <select name="contentType">
              {{#each contentTypes}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>

          <div class="gmo-field">
            <label>Cadre</label>
            <select name="frameStyle">
              <optgroup label="Cadres intégrés">
                {{#each frameStyles.builtins}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </optgroup>
              {{#if frameStyles.hasCustom}}
                <optgroup label="Cadres personnalisés">
                  {{#each frameStyles.custom}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </optgroup>
              {{/if}}
            </select>
          </div>

          <div class="gmo-field gmo-custom-frame-options">
            <label>Épaisseur du cadre personnalisé</label>
            <div class="gmo-range-row">
              <input name="customFrameThickness" type="range" min="6" max="48" step="1" value="{{customFrameThickness}}">
              <output>{{customFrameThickness}} px</output>
            </div>
            <small class="gmo-field-help">Ajuste l'épaisseur du 9-slice automatique autour du média.</small>
          </div>

          <div class="gmo-field gmo-custom-frame-options">
            <label>Marge interne du cadre personnalisé</label>
            <div class="gmo-range-row">
              <input name="customFramePadding" type="range" min="0" max="40" step="1" value="{{customFramePadding}}">
              <output>{{customFramePadding}} px</output>
            </div>
            <small class="gmo-field-help">Crée un espace entre le média et le cadre sans modifier l'opacité du fond.</small>
          </div>

          <div class="gmo-field gmo-field-wide gmo-media-content-field">
            <label>Média</label>
            <div class="gmo-file-row">
              <input name="media" type="text" value="{{media}}" placeholder="images/scene.webp ou videos/transmission.webm">
              <button type="button" data-action="browse" title="Parcourir les fichiers">
                <i class="fa-solid fa-folder-open"></i>
              </button>
            </div>
          </div>

          <div class="gmo-field gmo-field-wide gmo-text-content-field">
            <label>Texte</label>
            <textarea name="textContent" rows="5" placeholder="Texte à afficher chez les joueurs">{{textContent}}</textarea>
          </div>

          <div class="gmo-field gmo-field-wide gmo-html-content-field">
            <label>HTML simple</label>
            <textarea name="htmlContent" rows="7" placeholder="<h2>Titre</h2><p>Contenu...</p>">{{htmlContent}}</textarea>
            <small class="gmo-field-help">Les scripts, événements JavaScript et styles inline sont filtrés automatiquement.</small>
          </div>

          <div class="gmo-field gmo-rich-options-field">
            <label>Texte — alignement</label>
            <select name="textAlign">
              {{#each textAligns}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>

          <div class="gmo-field gmo-rich-options-field">
            <label>Texte — taille / couleur</label>
            <div class="gmo-inline-inputs">
              <input name="textFontSize" type="number" min="8" max="96" step="1" value="{{textFontSize}}" title="Taille de police en pixels">
              <input name="textColor" type="color" value="{{textColor}}" title="Couleur du texte">
            </div>
          </div>

          <div class="gmo-field">
            <label>Largeur initiale / mode fixe</label>
            <div class="gmo-inline-inputs">
              <input name="width" type="number" min="1" max="4000" step="1" value="{{width}}">
              <select name="widthUnit">
                {{#each widthUnits}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          </div>

          <div class="gmo-field">
            <label>Hauteur initiale / mode fixe</label>
            <div class="gmo-inline-inputs">
              <input name="height" type="number" min="0" max="4000" step="1" value="{{height}}">
              <select name="heightUnit">
                {{#each heightUnits}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          </div>

          <div class="gmo-field">
            <label>Mode de positionnement</label>
            <select name="placementMode">
              {{#each placementModes}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <small class="gmo-placement-hint gmo-hint-fixed">La fenêtre reste à l'un des 9 points prédéfinis.</small>
            <small class="gmo-placement-hint gmo-hint-gm">Le MJ déplace et redimensionne la fenêtre ; les joueurs suivent en direct.</small>
            <small class="gmo-placement-hint gmo-hint-player">Chaque joueur déplace et redimensionne sa copie indépendamment.</small>
          </div>

          <div class="gmo-field">
            <label>Position initiale</label>
            <select name="position">
              {{#each positions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>

          <div class="gmo-field gmo-floating-status">
            <label>Position flottante</label>
            <div class="gmo-floating-position-row">
              <span data-floating-coordinates>X {{floatX}} % · Y {{floatY}} %</span>
              <button type="button" data-action="resetPosition" title="Réinitialiser position et taille">
                <i class="fa-solid fa-crosshairs"></i> Réinitialiser
              </button>
            </div>
            <input name="floatX" type="hidden" value="{{floatX}}">
            <input name="floatY" type="hidden" value="{{floatY}}">
            <input name="floatWidth" type="hidden" value="{{floatWidth}}">
            <input name="floatHeight" type="hidden" value="{{floatHeight}}">
          </div>

          <div class="gmo-field gmo-options-field">
            <label>Affichage</label>
            <div class="gmo-check-row">
              <label title="Le redimensionnement des images et vidéos conserve toujours le ratio d’origine"><input name="preserveRatio" type="checkbox" checked disabled> Ratio média verrouillé</label>
              <label><input name="darkBackdrop" type="checkbox" {{#if darkBackdrop}}checked{{/if}}> Fond sombre plein écran</label>
              <label><input name="allowPlayerClose" type="checkbox" {{#if allowPlayerClose}}checked{{/if}}> Joueur peut fermer</label>
            </div>
          </div>

          <div class="gmo-field">
            <label>Opacité du contenu</label>
            <div class="gmo-range-row">
              <input name="contentOpacity" type="range" min="10" max="100" step="1" value="{{contentOpacity}}">
              <output>{{contentOpacity}} %</output>
            </div>
          </div>

          <div class="gmo-field">
            <label>Opacité du fond de fenêtre</label>
            <div class="gmo-range-row">
              <input name="backgroundOpacity" type="range" min="0" max="100" step="1" value="{{backgroundOpacity}}">
              <output>{{backgroundOpacity}} %</output>
            </div>
          </div>

          <div class="gmo-field gmo-field-wide gmo-video-options">
            <label>Options vidéo</label>
            <div class="gmo-check-row">
              <label><input name="autoplay" type="checkbox" {{#if autoplay}}checked{{/if}}> Lecture auto</label>
              <label><input name="loop" type="checkbox" {{#if loop}}checked{{/if}}> Boucle</label>
              <label><input name="muted" type="checkbox" {{#if muted}}checked{{/if}}> Muet</label>
              <label><input name="controls" type="checkbox" {{#if controls}}checked{{/if}}> Contrôles</label>
            </div>
          </div>

          <div class="gmo-field gmo-field-wide gmo-targeting">
            <label>Destinataires</label>
            <select name="targetMode">
              <option value="allPlayers" {{#if isAllPlayersMode}}selected{{/if}}>Tous les joueurs</option>
              <option value="selected" {{#if isSelectedMode}}selected{{/if}}>Joueurs sélectionnés</option>
            </select>

            <div class="gmo-user-list">
              {{#each users}}
                <label class="gmo-user {{#unless active}}is-offline{{/unless}}">
                  <input name="recipient" type="checkbox" value="{{id}}" {{#if selected}}checked{{/if}}>
                  <span class="gmo-user-dot"></span>
                  <span>{{name}}</span>
                </label>
              {{/each}}
            </div>

            <label class="gmo-include-gm">
              <input name="includeGM" type="checkbox" {{#if includeGM}}checked{{/if}}>
              Afficher aussi sur mon écran MJ
            </label>
          </div>
        </div>

        <footer class="gmo-card-actions">
          <button type="button" data-action="save" title="Enregistrer sans modifier l'affichage chez les joueurs">
            <i class="fa-solid fa-floppy-disk"></i> Enregistrer
          </button>
          <button type="button" data-action="preview">
            <i class="fa-solid fa-eye"></i> Aperçu
          </button>
          <button type="button" data-action="show" class="gmo-primary">
            <i class="fa-solid fa-display"></i> {{#if active}}Mettre à jour{{else}}Afficher{{/if}}
          </button>
          <button type="button" data-action="close" {{#unless active}}disabled{{/unless}}>
            <i class="fa-solid fa-eye-slash"></i> Fermer
          </button>
          <button type="button" data-action="delete" class="gmo-danger" title="Supprimer cette fenêtre">
            <i class="fa-solid fa-trash"></i>
          </button>
        </footer>
      </article>
    {{/each}}
  </div>
</section>
